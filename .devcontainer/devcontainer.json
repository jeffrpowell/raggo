{
	"name": "Raggo Go Development",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/raggo",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": false
		},
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
			"installOhMyZsh": true,
			"upgradePackages": true
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"ms-azuretools.vscode-docker",
				"eamodio.gitlens",
				"tamasfe.even-better-toml",
				"anthropic.claude-code"
			],
			"settings": {
				"go.toolsManagement.checkForUpdates": "local",
				"go.useLanguageServer": true,
				"go.lintTool": "golangci-lint",
				"go.lintOnSave": "workspace",
				"editor.formatOnSave": true,
				"[go]": {
					"editor.defaultFormatter": "golang.go",
					"editor.codeActionsOnSave": {
						"source.organizeImports": "explicit"
					}
				}
			}
		}
	},
	"forwardPorts": [
		6333,
		6334,
		9998
	],
	"portsAttributes": {
		"6333": {
			"label": "Qdrant HTTP",
			"onAutoForward": "notify"
		},
		"6334": {
			"label": "Qdrant gRPC",
			"onAutoForward": "notify"
		},
		"9998": {
			"label": "Tika HTTP",
			"onAutoForward": "notify"
		}
	},
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"containerEnv": {
		"CGO_ENABLED": "1",
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
		"NODE_EXTRA_CA_CERTS": "/usr/local/share/ca-certificates/CWA-ROOT-CA1.crt"
	},
	"remoteUser": "vscode",
	"mounts": [
		"source=claude-code-history,target=/home/vscode/.claude,type=volume",
		"source=/usr/local/share/ca-certificates/CWA-ROOT-CA1.crt,target=/usr/local/share/ca-certificates/CWA-ROOT-CA1.crt,type=bind,consistency=cached"
	]
}