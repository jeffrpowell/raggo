# API keys for raggo's service endpoints. Copy to .env (gitignored) next to
# docker-compose.orchestrator.yml. Leave a key empty if the service has no
# auth. A matching *_api_key set in raggo.yml takes precedence over these.
#
# STT, embed, context, vision, and Tika keys are sent as
# "Authorization: Bearer <key>". The Qdrant key is sent as Qdrant's api-key.
#
# Compose expands ${VAR} in .env, so services behind one llama-swap can share
# a key:
#   LLAMA_SWAP_API_KEY=sk-...
#   RAGGO_EMBED_API_KEY=${LLAMA_SWAP_API_KEY}

RAGGO_STT_API_KEY=
RAGGO_EMBED_API_KEY=
RAGGO_CONTEXT_API_KEY=
RAGGO_VISION_API_KEY=
RAGGO_TIKA_API_KEY=
RAGGO_QDRANT_API_KEY=
